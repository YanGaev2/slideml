<deck lang="ru-RU">
  <!-- СИГНАЛ+ round 4. Swiss grid, paper + ink + one orange signal block.
       Motif: the editor SELECTION FRAME (frame, 8 handles, tag with the real object name = element id).
       Rule: the frame sits exactly on the bounds of a real object (a shape, a padded text box,
       or a group whose bounds rect is part of the group). Tag: 6 pt outside the frame, above it,
       or below it when the space above is taken.
       Grid: 960x540, margins 48, 12 cols x 50, gutter 24. Col n left = 48 + 74*(n-1).
       Leading: line pitch = 1.2 * size * line-height, so styles store target-em / 1.2.
       Text colours are pre-mixed (no alpha on text): PowerPoint dithers semi-transparent glyphs. -->
  <theme font="Inter" heading="Inter SemiBold"
    lt1="#F4F3EF" dk1="#111111" dk2="#6B6A66" lt2="#D9D7D1"
    accent1="#FF4F12" accent2="#111111" accent3="#6B6A66"
    accent4="#D9D7D1" accent5="#6B6A66" accent6="#D9D7D1"/>

  <!-- Type scale: 10 / 12 / 14 / 16 / 22 / 40 / 84 / 132 / 400 -->
  <styles>
    <style name="display" font="heading" size="84" spacing="-2.5" line-height="0.79" color="dk1"/>
    <style name="hero"    font="heading" size="132" spacing="-4" line-height="0.75" color="dk1"/>
    <style name="hero-xl" font="heading" size="400" spacing="-10" line-height="0.71" color="dk1"/>
    <style name="h1"      font="heading" size="40" spacing="-1" line-height="0.88" color="dk1"/>
    <style name="num"     font="heading" size="40" spacing="-1" line-height="0.83" color="dk1"/>
    <style name="h2"      font="heading" size="22" spacing="-0.3" line-height="0.96" color="dk1"/>
    <style name="body"    font="Inter" size="16" line-height="1.12" color="dk2"/>
    <style name="body-s"  font="Inter" size="14" line-height="1.12" color="dk2"/>
    <style name="fact"    font="Inter" size="16" line-height="1" color="dk2"/>
    <style name="label"   font="Cascadia Mono" size="12" spacing="1" caps="1" line-height="1" color="dk2"/>
    <style name="code"    font="Cascadia Mono" size="16" line-height="1.04" color="dk1"/>
    <style name="chrome"  font="Cascadia Mono" size="10" spacing="1" caps="1" line-height="1"/>
  </styles>

  <templates>
    <template id="chrome">
      <text id="chrome-brand" x="48" y="24" w="64" h="auto" class="chrome" color="{{ink}}">SLIDEML</text>
      <text id="chrome-section" x="104" y="24" w="420" h="auto" class="chrome" color="{{ink}}">/ {{section}}</text>
      <line id="chrome-top" x1="48" y1="48" x2="912" y2="48" stroke="{{rule}} 0.75"/>
      <line id="chrome-bot" x1="48" y1="500" x2="912" y2="500" stroke="{{rule}} 0.75"/>
      <text id="chrome-foot" x="48" y="512" w="420" h="auto" class="chrome" color="{{ink}}">Собрано агентом в SlideML</text>
      <text id="chrome-page" x="714" y="512" w="198" h="auto" class="chrome" color="{{ink}}" align="right">{{page}} / 08</text>
    </template>
    <!-- Cover: the same ids without section and page. -->
    <template id="cover">
      <text id="chrome-brand" x="48" y="24" w="64" h="auto" class="chrome" color="dk2">SLIDEML</text>
      <line id="chrome-top" x1="48" y1="48" x2="912" y2="48" stroke="#111111/15 0.75"/>
      <line id="chrome-bot" x1="48" y1="500" x2="912" y2="500" stroke="#111111/15 0.75"/>
      <text id="chrome-foot" x="48" y="512" w="420" h="auto" class="chrome" color="dk2">Собрано агентом в SlideML</text>
    </template>

    <!-- Selection frame. dx/dy = frame top-left = target top-left. Pass r = w-3, b = h-3, mx = w/2-3, my = h/2-3,
         tx/ty = tag position (ty=-22 above, ty=h+6 below), tw = tag width (Cascadia 10: id width + 10). -->
    <template id="sel">
      <shape id="sel-frame" geom="rect" x="0" y="0" w="{{w}}" h="{{h}}" fill="none" line="dk1 1"/>
      <shape id="sel-h1" geom="rect" x="-3" y="-3" w="6" h="6" fill="lt1" line="dk1 1"/>
      <shape id="sel-h2" geom="rect" x="{{mx}}" y="-3" w="6" h="6" fill="lt1" line="dk1 1"/>
      <shape id="sel-h3" geom="rect" x="{{r}}" y="-3" w="6" h="6" fill="lt1" line="dk1 1"/>
      <shape id="sel-h4" geom="rect" x="{{r}}" y="{{my}}" w="6" h="6" fill="lt1" line="dk1 1"/>
      <shape id="sel-h5" geom="rect" x="{{r}}" y="{{b}}" w="6" h="6" fill="lt1" line="dk1 1"/>
      <shape id="sel-h6" geom="rect" x="{{mx}}" y="{{b}}" w="6" h="6" fill="lt1" line="dk1 1"/>
      <shape id="sel-h7" geom="rect" x="-3" y="{{b}}" w="6" h="6" fill="lt1" line="dk1 1"/>
      <shape id="sel-h8" geom="rect" x="-3" y="{{my}}" w="6" h="6" fill="lt1" line="dk1 1"/>
      <shape id="sel-tag" geom="rect" x="{{tx}}" y="{{ty}}" w="{{tw}}" h="16" fill="dk1" line="none" pad="0 5 0 5" anchor="middle" wrap="0"
             font="Cascadia Mono" size="10" color="lt1">{{tag}}</shape>
    </template>
  </templates>

  <!-- S1 COVER: the signal block is a selected native rectangle and shows its own properties. -->
  <slide id="s1" bg="lt1" transition="fade" transition-dur="800">
    <use template="cover"/>
    <text id="s1-kicker" x="48" y="96" w="642" h="auto" class="label">AI-native формат презентаций</text>
    <text id="s1-title" x="44" y="128" w="646" h="auto" class="display">Презентации,<br/>которые пишет<br/>агент<span color="accent1">.</span></text>
    <shape id="signal" geom="rect" x="714" y="96" w="198" h="392" fill="accent1" line="none" anchor="bottom" pad="0 16 16 16"
           font="Cascadia Mono" size="12" color="dk1" line-height="1.15">x 714 · y 96<br/>w 198 · h 392<br/>fill #FF4F12</shape>
    <group id="s1-sel">
      <use template="sel" dx="714" dy="96" w="198" h="392" r="195" b="389" mx="96" my="193"
           tx="0" ty="-22" tw="46" tag="signal"/>
    </group>
    <group id="s1-sub">
      <text id="s1-code" x="48" y="416" w="642" h="auto" class="code">deck.xml → slideml build → .pptx</text>
      <text id="s1-body" x="48" y="448" w="642" h="auto" class="body" color="dk1">Нативный редактируемый .pptx. Эту презентацию тоже собрал агент.</text>
    </group>
    <anim target="signal" effect="wipe-bottom" start="after" dur="500"/>
    <anim target="s1-sel" effect="appear" start="after" delay="150"/>
    <anim target="s1-sub" effect="fade" start="after" dur="300"/>
  </slide>

  <!-- S2 PROBLEM: a screenshot is one picture object; a converter loses fonts and motion. -->
  <slide id="s2" bg="lt1" transition="morph" transition-dur="900">
    <use template="chrome" section="Проблема" page="02" ink="dk2" rule="#111111/15"/>
    <text id="s2-title" x="48" y="80" w="642" h="auto" class="h1">Агент делает слайды.<br/>PowerPoint получает картинку.</text>
    <shape id="signal" geom="rect" x="458" y="170" w="178" h="4" fill="accent1" line="none"/>

    <image id="s2-shot" src="assets/shot.png" x="48" y="240" w="198" h="104" fit="cover" tint="grayscale" alt="Скриншот слайда"/>
    <use template="sel" dx="48" dy="240" w="198" h="104" r="195" b="101" mx="96" my="49"
         tx="0" ty="-22" tw="52" tag="s2-shot"/>
    <group id="s2-left">
      <text id="s2-l-label" x="270" y="240" w="198" h="auto" class="label">Путь 01</text>
      <text id="s2-l-head" x="270" y="260" w="198" h="auto" class="h2">Скриншот</text>
      <text id="s2-l-body" x="270" y="292" w="198" h="auto" class="body-s">Playwright или Chrome снимают слайд в&#160;PNG. Править в&#160;нём нечего.</text>
    </group>

    <group id="s2-right">
      <group id="s2-conv">
        <shape id="s2-c-bg" geom="rect" x="492" y="240" w="198" h="104" fill="white" line="#111111/15 0.75"/>
        <text id="s2-c-t" x="504" y="250" w="104" h="40" font="Times New Roman" size="14" color="dk2" line-height="0.9" rot="-2">Акция «Снова в&#160;школу»</text>
        <shape id="s2-c-l1" geom="rect" x="504" y="288" w="78" h="4" fill="dk2/35" line="none"/>
        <shape id="s2-c-l2" geom="rect" x="504" y="296" w="92" h="4" fill="dk2/35" line="none"/>
        <shape id="s2-c-ph" geom="rect" x="614" y="252" w="64" h="48" fill="none" line="dk2 0.75 dash"/>
        <icon id="s2-c-ic" name="image-off" x="636" y="266" w="20" h="20" color="dk2" weight="1.5"/>
        <text id="s2-c-meta" x="504" y="312" w="180" h="auto" font="Cascadia Mono" size="11" color="dk2" line-height="1">шрифт: fallback<br/>anim: 0</text>
      </group>
      <text id="s2-r-label" x="714" y="240" w="198" h="auto" class="label">Путь 02</text>
      <text id="s2-r-head" x="714" y="260" w="198" h="auto" class="h2">Конвертер</text>
      <text id="s2-r-body" x="714" y="292" w="198" h="auto" class="body-s">Marp, Slidev, экспорт Gamma, pandoc. Теряются анимации, шрифты, правки.</text>
    </group>

    <line id="s2-rule-c" x1="48" y1="376" x2="912" y2="376" stroke="#111111/15 0.75"/>
    <group id="s2-why">
      <text id="s2-cause-l" x="48" y="392" w="198" h="auto" class="label">Причина</text>
      <text id="s2-cause" x="48" y="416" w="864" h="auto" class="h2" size="28">Одна на&#160;двоих: модель HTML/CSS не&#160;ложится на&#160;DrawingML.</text>
    </group>
    <anim target="s2-right" effect="fade" start="after" delay="200"/>
    <anim target="s2-why" effect="fade" start="click"/>
  </slide>

  <!-- S3 INSIGHT (dark): the rejected verb is struck, then the answer arrives; the compiler is the signal. -->
  <slide id="s3" bg="dk1" transition="morph" transition-dur="900">
    <use template="chrome" section="Инсайт" page="03" ink="#888886" rule="white/20"/>
    <text id="s3-not" x="44" y="104" w="868" h="auto" class="display" color="#5E5E5C">Не экспортировать.</text>
    <line id="s3-strike" x1="50" y1="140" x2="842" y2="140" stroke="#5E5E5C 5"/>
    <group id="s3-ans">
      <text id="s3-yes" x="44" y="196" w="868" h="auto" class="display" color="white">Компилировать.</text>
      <text id="s3-body" x="48" y="312" w="642" h="auto" class="body" color="#B8B8B6">SlideML — не конвертер, а компилятор.<br/>Каждый элемент XML становится объектом DrawingML.</text>
    </group>

    <shape id="signal" geom="rect" x="344" y="392" w="272" h="56" fill="accent1" line="none" anchor="middle" align="center"
           font="Cascadia Mono" size="14" color="dk1" line-height="1.2">slideml · Rust<br/>3&#160;426 строк</shape>
    <group id="s3-pipe">
      <shape id="s3-in" geom="rect" x="48" y="392" w="198" h="56" fill="none" line="white/30 1" anchor="middle" align="center"
             font="Cascadia Mono" size="16" color="#B8B8B6">deck.xml</shape>
      <line id="s3-a1" x1="254" y1="420" x2="336" y2="420" stroke="white/70 1.5" tail="triangle"/>
      <line id="s3-a2" x1="624" y1="420" x2="706" y2="420" stroke="white/70 1.5" tail="triangle"/>
      <shape id="s3-out" geom="rect" x="714" y="392" w="198" h="56" fill="none" line="white 1" anchor="middle" align="center"
             font="Cascadia Mono" size="16" color="white">deck.pptx</shape>
    </group>
    <anim target="s3-strike" effect="wipe-left" start="after" delay="300" dur="400"/>
    <anim target="s3-ans" effect="float-up" start="after" dur="500"/>
    <anim target="s3-pipe" effect="wipe-left" start="click" dur="700"/>
  </slide>

  <!-- S4 LINE = OBJECT: each code line arrives with its object; line 1 is selected. -->
  <slide id="s4" bg="lt1" transition="morph" transition-dur="900">
    <use template="chrome" section="Как устроено" page="04" ink="dk2" rule="#111111/15"/>
    <text id="s4-title" x="44" y="80" w="868" h="auto" class="display">Строка = объект.</text>
    <text id="s4-file" x="48" y="184" w="420" h="auto" class="label">deck.xml</text>
    <shape id="s4-panel" geom="rect" x="48" y="208" w="420" h="208" fill="dk1" line="none"/>
    <line id="s4-sep1" x1="48" y1="264" x2="468" y2="264" stroke="white/8 0.75"/>
    <line id="s4-sep2" x1="48" y1="312" x2="468" y2="312" stroke="white/8 0.75"/>
    <line id="s4-sep3" x1="48" y1="360" x2="468" y2="360" stroke="white/8 0.75"/>
    <shape id="signal" geom="rect" x="48" y="226" w="420" h="28" fill="accent1" line="none"/>

    <group id="s4-r1">
      <text id="s4-g1" x="60" y="208" w="24" h="auto" class="code" line-height="2.5" color="dk1" align="right">1</text>
      <text id="s4-c1" x="100" y="208" w="356" h="auto" class="code" line-height="2.5" color="dk1">&lt;shape geom="roundRect"/&gt;</text>
      <line id="s4-l1" x1="476" y1="240" x2="556" y2="240" stroke="#111111 1" head="oval"/>
      <shape id="s4-o1" geom="roundRect" x="571" y="225" w="30" h="30" radius="6" fill="none" line="dk1 2.5"/>
      <text id="s4-f1" x="640" y="230" w="272" h="auto" class="fact"><span font="heading" color="dk1">187</span> фигур + SVG-контуры</text>
    </group>
    <use template="sel" dx="571" dy="225" w="30" h="30" r="27" b="27" mx="12" my="12"
         tx="0" ty="-22" tw="40" tag="s4-o1"/>
    <group id="s4-r2">
      <text id="s4-g2" x="60" y="256" w="24" h="auto" class="code" line-height="2.5" color="#555553" align="right">2</text>
      <text id="s4-c2" x="100" y="256" w="356" h="auto" class="code" line-height="2.5" color="#B0AFAC">&lt;icon name="zap"/&gt;</text>
      <line id="s4-l2" x1="476" y1="288" x2="556" y2="288" stroke="#111111 1" head="oval"/>
      <icon id="s4-o2" name="zap" x="568" y="270" w="36" h="36" color="dk1" weight="1.75"/>
      <text id="s4-f2" x="640" y="278" w="272" h="auto" class="fact"><span font="heading" color="dk1">2&#160;154</span> иконки Lucide</text>
    </group>
    <group id="s4-r3">
      <text id="s4-g3" x="60" y="304" w="24" h="auto" class="code" line-height="2.5" color="#555553" align="right">3</text>
      <text id="s4-c3" x="100" y="304" w="356" h="auto" class="code" line-height="2.5" color="#B0AFAC">&lt;chart type="column"&gt;…</text>
      <line id="s4-l3" x1="476" y1="336" x2="556" y2="336" stroke="#111111 1" head="oval"/>
      <chart id="s4-o3" type="column" x="571" y="321" w="30" h="30" axis="none" legend="none" labels="0" gap="60" plot="0 0 0 0" min="0" max="4">
        <cat>a, b, c, d</cat>
        <series name="s" values="2, 3, 2.5, 4" colors="dk1, dk1, dk1, dk1"/>
        <ref id="s4-o3-ref" value="3" stroke="accent1 1.5"/>
      </chart>
      <text id="s4-f3" x="640" y="326" w="272" h="auto" class="fact"><span font="heading" color="dk1">Графики</span> с&#160;книгой Excel</text>
    </group>
    <group id="s4-r4">
      <text id="s4-g4" x="60" y="352" w="24" h="auto" class="code" line-height="2.5" color="#555553" align="right">4</text>
      <text id="s4-c4" x="100" y="352" w="356" h="auto" class="code" line-height="2.5" color="#B0AFAC">&lt;anim effect="float-up"/&gt;</text>
      <line id="s4-l4" x1="476" y1="384" x2="556" y2="384" stroke="#111111 1" head="oval"/>
      <icon id="s4-o4" name="play" x="568" y="366" w="36" h="36" color="dk1" weight="1.75"/>
      <text id="s4-f4" x="640" y="374" w="272" h="auto" class="fact"><span font="heading" color="dk1">14</span> нативных анимаций</text>
    </group>
    <text id="s4-more" x="48" y="448" w="642" h="auto" class="body-s">Также нативно: таблицы, группы, переходы fade, push, wipe и&#160;morph, шаблоны и&#160;стили.</text>
    <anim target="s4-r2" effect="wipe-left" start="after" delay="200" dur="300"/>
    <anim target="s4-r3" effect="wipe-left" start="after" dur="300"/>
    <anim target="s4-r4" effect="wipe-left" start="after" dur="300"/>
  </slide>

  <!-- S5 PROOF: TEXT. 367 checked text blocks as a grid in check order; the 2 misses (#101, #120)
       are orange at their real positions. The signal morphs into block #101. -->
  <slide id="s5" bg="lt1" transition="morph" transition-dur="900">
    <use template="chrome" section="Доказательство" page="05" ink="dk2" rule="#111111/15"/>
    <text id="s5-label" x="48" y="80" w="494" h="auto" class="label">Точность вёрстки</text>
    <text id="s5-hero" x="41" y="124" w="560" h="128" class="hero">99,5<span size="44"> </span>%</text>
    <text id="s5-head" x="640" y="108" w="272" h="auto" class="h2">Текст не вылезет за&#160;рамку: агент знает это до&#160;рендера.</text>
    <text id="s5-body" x="640" y="196" w="272" h="auto" class="body">Сверили с&#160;PowerPoint 367 блоков из&#160;четырёх тестовых презентаций. В&#160;365 число строк совпало.</text>

