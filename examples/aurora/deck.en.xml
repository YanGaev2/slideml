    <shape id="blob-v" geom="ellipse" x="560" y="-40" w="520" h="620" fill="radial(#8A4DFF/80 0%, #8A4DFF/0 70%)" soft-edge="140"/>

    <text id="cover-kicker" x="70" y="84" w="500" h="18" size="11" caps="1" spacing="2" color="white/75">Pre-Series A · Moscow, 2026</text>
    <text id="cover-title" x="64" y="104" w="620" h="130" font="heading" size="96" color="white">Neuron</text>
    <text id="cover-sub" x="470" y="380" w="420" h="70" size="20" align="right" line-height="1.15" color="white">AI checks documents for banks<br/>in 90 seconds, not 40 minutes</text>

