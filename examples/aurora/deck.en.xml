    <text id="brand" x="40" y="474" w="110" h="16" size="10" color="white">Neuron AI</text>
    <text id="pg" x="860" y="474" w="60" h="16" size="10" align="right" color="white/70">02 / 06</text>
    <text id="p-src" x="40" y="500" w="700" h="14" size="9" color="white/55">Illustrative figures: team estimate based on interviews with 14 banks</text>

    <anim target="p-title" effect="fade" start="after" dur="400"/>
    <anim target="s1" effect="float-up" start="after" dur="500"/>
    <anim target="s2" effect="float-up" start="with" delay="150" dur="500"/>
    <anim target="s3" effect="float-up" start="with" delay="300" dur="500"/>
