    <shape id="blob-c" geom="ellipse" x="-120" y="140" w="760" h="780" fill="radial(#19C9E0/45 0%, #19C9E0/0 70%)" soft-edge="140"/>
    <shape id="blob-p" geom="ellipse" x="480" y="300" w="640" h="420" fill="radial(#B24DFF/40 0%, #B24DFF/0 70%)" soft-edge="140"/>
    <shape id="blob-v" geom="ellipse" x="620" y="40" w="700" h="820" fill="radial(#8A4DFF/60 0%, #8A4DFF/0 70%)" soft-edge="140"/>

    <text id="p-title" x="70" y="50" w="820" h="60" font="heading" size="40" color="white">The problem</text>
    <text id="p-sub" x="70" y="118" w="800" h="24" size="15" color="white/80">Banks check loan files by hand. It is slow, costly, and misses forgeries.</text>

    <group id="s1">
      <line x1="70" y1="190" x2="320" y2="190" stroke="white/60 0.75"/>
      <text x="70" y="206" w="260" h="64" font="heading" size="44" color="white">40 <span size="26" color="accent1">min</span></text>
      <text x="70" y="276" w="240" h="64" size="13" line-height="1.25" color="white/80">of an employee's time to check one document package by hand</text>
    </group>
    <group id="s2">
      <line x1="360" y1="190" x2="610" y2="190" stroke="white/60 0.75"/>
      <text x="360" y="206" w="260" h="64" font="heading" size="44" color="white">8<span size="26" color="accent1">%</span></text>
      <text x="360" y="276" w="240" h="64" size="13" line-height="1.25" color="white/80">of loan files (1 in 12) contain an error, mismatch, or forgery</text>
    </group>
    <group id="s3">
      <line x1="650" y1="190" x2="890" y2="190" stroke="white/60 0.75"/>
      <text x="650" y="206" w="260" h="64" font="heading" size="44" color="white"><span size="26" font="Manrope SemiBold" color="accent1">₽</span>2.3<span size="26" color="accent1">B</span></text>
      <text x="650" y="276" w="240" h="64" size="13" line-height="1.25" color="white/80">a large bank loses to document fraud every year</text>
    </group>

    <text id="p-note" x="70" y="372" w="820" h="56" font="heading" size="18" line-height="1.25" color="white">Result: loans wait in the review queue,<br/>and forgeries still slip through</text>

