      <shape geom="roundRect" radius="14" x="700" y="200" w="190" h="226" fill="white/5" line="none"/>
      <shape geom="roundRect" radius="10" x="718" y="218" w="44" h="44" fill="accent1"/>
      <icon name="badge-check" x="728" y="228" w="24" h="24" color="#0A0F5C" weight="2"/>
      <text x="830" y="222" w="44" h="16" size="10" align="right" color="white/50">04</text>
      <text x="718" y="278" w="164" h="26" font="heading" size="17" color="white">Decides</text>
