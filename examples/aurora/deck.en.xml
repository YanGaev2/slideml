    <text id="brand" x="40" y="474" w="110" h="16" size="10" color="white">Neuron AI</text>
    <text id="pg" x="860" y="474" w="60" h="16" size="10" align="right" color="white/70">01 / 06</text>

    <anim target="cover-kicker" effect="fade" start="after" dur="500"/>
    <anim target="cover-title" effect="float-up" start="with" delay="150" dur="800"/>
    <anim target="cover-sub" effect="fade" start="after" dur="700"/>
  </slide>

  <!-- 2. Problem -->
