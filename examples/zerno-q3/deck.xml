<deck lang="ru-RU">
  <theme font="Manrope" heading="Unbounded SemiBold"
         dk1="#1E1A17" lt1="#F7F3EC" dk2="#6E655C" lt2="#E4DDD2"
         accent1="#C2410C" accent2="#1E1A17" accent3="#6E655C" accent4="#E4DDD2" accent5="#6E655C" accent6="#E4DDD2"/>

  <styles>
    <style name="kpi"       font="heading" size="120" spacing="-3" line-height="0.85" color="dk1"/>
    <style name="kpi-muted" font="heading" size="60" spacing="-1.5" line-height="0.9" color="dk2"/>
    <style name="display"   font="heading" size="54" spacing="-1.5" line-height="0.92" color="dk1"/>
    <style name="h1"        font="heading" size="32" spacing="-0.6" line-height="1" color="dk1"/>
    <style name="h2"        font="heading" size="20" line-height="1.05" color="dk1"/>
    <style name="body"      size="16" line-height="1.2" color="dk2"/>
    <style name="quote"     font="heading" size="36" spacing="-0.5" line-height="1.05" color="lt1"/>
    <style name="label"     font="Cascadia Mono" size="11" caps="1" spacing="1" color="dk2"/>
    <style name="chrome"    font="Cascadia Mono" size="10" caps="1" spacing="1" color="dk2"/>
    <style name="credit"    size="10" color="lt1/70"/>
  </styles>

  <templates>
    <template id="chrome">
      <text id="chrome-brand" x="48" y="24" w="420" h="auto" class="chrome">{{section}}</text>
      <line id="chrome-top" x1="48" y1="48" x2="912" y2="48" stroke="dk1/15 0.75"/>
      <line id="chrome-bot" x1="48" y1="500" x2="912" y2="500" stroke="dk1/15 0.75"/>
      <text id="chrome-page" x="714" y="512" w="198" h="auto" class="chrome" align="right">{{page}}</text>
    </template>
    <template id="chrome-plain">
      <text id="chrome-brand" x="48" y="24" w="420" h="auto" class="chrome" color="lt1/70">{{section}}</text>
      <text id="chrome-page" x="714" y="512" w="198" h="auto" class="chrome" color="lt1/70" align="right">{{page}}</text>
    </template>
  </templates>

  <!-- A1 · Заработали 4,5 млн ₽ за квартал и выросли до 5 точек -->
  <slide id="cover" bg="dk1" transition="fade" transition-dur="700">
    <image id="cover-photo" src="assets/latte-coffee-cup-barista-2.jpg" x="0" y="0" w="960" h="540" fit="cover" tint="duotone(#1E1A17, #E9D8C4)"/>
    <shape id="cover-shade" x="0" y="0" w="960" h="540" fill="linear(0, dk1/92 0%, dk1/60 55%, dk1/10 100%)" line="none"/>
    <use template="chrome-plain" section="Кофейня «Зерно» · Итоги Q3 2026" page="01"/>
    <text id="cover-label" x="48" y="196" w="560" h="auto" class="label" color="lt1/70">Отчёт для инвесторов</text>
    <text id="cover-title" x="48" y="224" w="640" h="auto" class="display" size="44" color="lt1">Заработали 4,5&#160;млн&#160;₽ за&#160;квартал и&#160;выросли до&#160;5&#160;точек</text>
    <text id="cover-kpis" x="48" y="440" w="640" h="auto" class="body" color="lt1/80">Сентябрь 1,9 млн ₽ · средний чек 420 ₽ · оценка 4,8 в&#160;Яндекс&#160;Картах</text>
    <text id="cover-credit" x="48" y="512" w="420" h="auto" class="credit">Фото: Nathan Dumlao, CC0</text>
  </slide>

  <!-- A5 · Выручка росла каждый месяц: сентябрь +58 % к июлю -->
  <slide id="revenue" bg="lt1" transition="fade" transition-dur="600">
    <use template="chrome" section="Кофейня «Зерно» · Выручка" page="02"/>
    <text id="rev-title" x="48" y="72" w="864" h="auto" class="h1">Выручка росла каждый месяц: сентябрь +58&#160;% к&#160;июлю</text>
    <chart id="rev-chart" type="column" x="48" y="168" w="560" h="312" labels="1" label-bold="1" label-size="14" size="12" color="dk2" gap="70" format="0.0&quot; млн ₽&quot;">
      <cat>Июль, Август, Сентябрь</cat>
      <series name="Выручка, млн ₽" values="1.2, 1.4, 1.9" colors="lt2, lt2, accent1"/>
      <note at="Сентябрь" w="170" size="12" fill="dk1" color="lt1">+58 % к июлю</note>
    </chart>
    <text id="rev-total-l" x="640" y="196" w="272" h="auto" class="label">Итого за квартал</text>
    <text id="rev-total" x="640" y="220" w="272" h="auto" class="h1" size="36">4,5 млн ₽</text>
    <text id="rev-why" x="640" y="284" w="272" h="auto" class="body">Рост дали две новые точки и&#160;средний чек выше на&#160;11&#160;%. Вклад в&#160;цифрах [уточнить].</text>
    <anim target="rev-chart" effect="wipe-bottom" start="after" dur="800"/>
  </slide>

  <!-- A4 · Средний чек вырос на 11 % — до 420 ₽ -->
  <slide id="check" bg="lt1" transition="fade" transition-dur="600">
    <use template="chrome" section="Кофейня «Зерно» · Средний чек" page="03"/>
    <text id="chk-title" x="48" y="72" w="864" h="auto" class="h1">Средний чек вырос на&#160;11&#160;% — до&#160;420&#160;₽</text>
    <text id="chk-before-l" x="48" y="196" w="240" h="auto" class="label">Было до Q3</text>
    <text id="chk-before" x="48" y="222" w="300" h="auto" class="kpi-muted">380 ₽</text>
    <line id="chk-arrow" x1="356" y1="256" x2="428" y2="256" stroke="dk1 2" tail="triangle"/>
    <text id="chk-after-l" x="452" y="196" w="300" h="auto" class="label">Стало</text>
    <text id="chk-after" x="448" y="214" w="464" h="auto" class="kpi" size="100" color="accent1">420 ₽</text>
    <text id="chk-delta" x="48" y="368" w="560" h="auto" class="h2" color="accent1">+40 ₽ к каждому чеку · +11 %</text>
    <text id="chk-why" x="48" y="408" w="560" h="auto" class="body">Причина роста: [уточнить — новое меню или поток в&#160;новых точках].</text>
    <anim target="chk-after" effect="zoom" start="after" dur="500"/>
  </slide>

  <!-- A7 · Сеть выросла до 5 точек, две открыли в Q3 -->
  <slide id="network" bg="lt1" transition="fade" transition-dur="600">
    <use template="chrome" section="Кофейня «Зерно» · Сеть" page="04"/>
    <text id="net-title" x="48" y="72" w="864" h="auto" class="h1">Сеть выросла до&#160;5&#160;точек, две открыли в&#160;Q3</text>
    <shape id="net-t1" x="48" y="160" w="156" h="196" radius="10" fill="lt2" line="none" anchor="bottom" pad="16" align="left" font="heading" size="28" color="dk1">1</shape>
    <shape id="net-t2" x="225" y="160" w="156" h="196" radius="10" fill="lt2" line="none" anchor="bottom" pad="16" align="left" font="heading" size="28" color="dk1">2</shape>
    <shape id="net-t3" x="402" y="160" w="156" h="196" radius="10" fill="lt2" line="none" anchor="bottom" pad="16" align="left" font="heading" size="28" color="dk1">3</shape>
    <shape id="net-t4" x="579" y="160" w="156" h="196" radius="10" fill="accent1" line="none" anchor="bottom" pad="16" align="left" font="heading" size="28" color="lt1">4</shape>
    <shape id="net-t5" x="756" y="160" w="156" h="196" radius="10" fill="accent1" line="none" anchor="bottom" pad="16" align="left" font="heading" size="28" color="lt1">5</shape>
    <line id="net-b1" x1="48" y1="372" x2="558" y2="372" stroke="dk2 1"/>
    <text id="net-b1t" x="48" y="384" w="510" h="auto" class="label">Работали до Q3</text>
    <line id="net-b2" x1="579" y1="372" x2="912" y2="372" stroke="accent1 1.5"/>
    <text id="net-b2t" x="579" y="384" w="333" h="auto" class="label" color="accent1">Открыты в Q3</text>
    <text id="net-f1v" x="48" y="424" w="420" h="auto" class="h1">≈ 380 тыс. ₽</text>
    <text id="net-f1l" x="48" y="462" w="420" h="auto" class="body" size="13">Выручка на&#160;точку в&#160;сентябре: 1,9&#160;млн&#160;₽ /&#160;5, без учёта даты&#160;открытия.</text>
    <text id="net-f2v" x="528" y="424" w="384" h="auto" class="h1">4,8</text>
    <text id="net-f2l" x="528" y="462" w="384" h="auto" class="body" size="13">Оценка гостей в&#160;Яндекс&#160;Картах. Базы для&#160;сравнения нет.</text>
    <anim target="net-t4" effect="zoom" start="after" dur="400"/>
    <anim target="net-t5" effect="zoom" start="after" dur="400"/>
  </slide>

  <!-- A9 · В Q4 откроем шестую точку и запустим доставку -->
  <slide id="plan" bg="dk1" transition="fade" transition-dur="700">
    <image id="plan-photo" src="assets/coffee-shop-interior-counter-1.jpg" x="0" y="0" w="960" h="540" fit="cover" tint="duotone(#1E1A17, #E9D8C4)"/>
    <shape id="plan-shade" x="0" y="0" w="960" h="540" fill="linear(90, dk1/96 0%, dk1/93 55%, dk1/78 100%)" line="none"/>
    <use template="chrome-plain" section="Кофейня «Зерно» · План Q4 2026" page="05"/>
    <text id="plan-title" x="48" y="72" w="700" h="auto" class="h1" color="lt1">В Q4 откроем шестую точку и&#160;запустим доставку</text>
    <line id="plan-axis" x1="48" y1="248" x2="912" y2="248" stroke="lt1/50 1.25"/>
    <shape id="plan-m1" geom="ellipse" x="42" y="242" w="12" h="12" fill="lt1" line="none"/>
    <text id="plan-d1" x="48" y="200" w="260" h="auto" class="label" color="lt1/70">Сейчас · конец Q3</text>
    <text id="plan-a1" x="48" y="272" w="260" h="auto" class="h2" color="lt1">5 точек, 4,5 млн ₽ за квартал</text>
    <shape id="plan-m2" geom="ellipse" x="330" y="242" w="12" h="12" fill="lt1" line="none"/>
    <text id="plan-d2" x="336" y="200" w="260" h="auto" class="label" color="lt1/70">[срок]</text>
    <text id="plan-a2" x="336" y="272" w="260" h="auto" class="h2" color="lt1">Шестая точка открыта</text>
    <text id="plan-g2" x="336" y="324" w="260" h="auto" class="body" color="lt1/70">Цель: [выручка точки, ₽ в&#160;месяц]</text>
    <shape id="plan-m3" geom="ellipse" x="618" y="242" w="12" h="12" fill="lt1" line="none"/>
    <text id="plan-d3" x="624" y="200" w="288" h="auto" class="label" color="lt1/70">[срок]</text>
    <text id="plan-a3" x="624" y="272" w="288" h="auto" class="h2" color="lt1">Запуск доставки</text>
    <text id="plan-g3" x="624" y="324" w="288" h="auto" class="body" color="lt1/70">Цель: [доля доставки в&#160;выручке]</text>
    <line id="plan-goal-rule" x1="48" y1="384" x2="912" y2="384" stroke="lt1/20 0.75"/>
    <text id="plan-goal" x="48" y="400" w="864" h="auto" class="h2" color="accent1">Цель к концу Q4: 6 точек и&#160;работающая доставка</text>
  </slide>
</deck>
